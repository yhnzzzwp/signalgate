SECTORS_API_KEY=replace_with_your_sectors_api_key
SECTORS_API_ENABLED=true

# laptop (default)  : qwen2.5:7b  + qwen3:4b                 -- muat di Mac/GPU kecil
# workstation        : qwen2.5:14b + glm4:9b + gemma3:12b      -- untuk GPU 16 GB
# Profil hanya mengubah model lokal. Nilai apa pun yang kamu tulis sendiri di bawah selalu menang.
SIGNALGATE_PROFILE=laptop

LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Arahkan ke mesin lain untuk memakai GPU-nya dari laptop ini:
# OLLAMA_BASE_URL=http://192.168.1.23:11434   (di mesin itu set OLLAMA_HOST=0.0.0.0)
OLLAMA_MODEL=qwen2.5:7b
# Reviewer dibaca berurutan, satu model di VRAM pada satu waktu. Maksimal 3.
# Isi ini ATAU OLLAMA_VALIDATOR_MODEL, tidak keduanya -- reviewer selalu menang.
OLLAMA_REVIEWER_MODELS=["glm4:9b","llama3.1:8b"]
OLLAMA_OFFLOAD_BETWEEN_MODELS=true
OLLAMA_NUM_CTX=16384

PIPELINE_MAX_EVENTS=3
RESEARCH_EXTRACTION_ATTEMPTS=2
RESEARCH_VALIDATOR_MODE=strict
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_MAX_PAGES=4
RESEARCH_CONTEXT_CHARS=3000
RESEARCH_SOURCE_URLS=[]

SIGNALGATE_DB_PATH=./signalgate.db
