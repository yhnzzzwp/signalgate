SECTORS_API_KEY=
# Key cadangan, JSON list. SectorsClient pindah otomatis ke sini kalau key di atas melaporkan
# kredit/kuota habis (code insufficient_credits, monthly_limit_exceeded, dst, atau HTTP 429).
SECTORS_API_KEY_BACKUPS=[]
SECTORS_API_ENABLED=false

# laptop (default)  : qwen2.5:7b  (analis)                                -- muat di Mac/GPU kecil
# workstation        : qwen2.5:14b (analis) + glm4:9b lalu gemma3:12b (pembanding) -- GPU 16 GB
# Profil hanya mengubah model lokal. Nilai apa pun yang kamu tulis sendiri di bawah SELALU menang atas
# profil, jadi baris OLLAMA_MODEL / OLLAMA_REVIEWER_MODELS / WORKFLOW_*_MODEL(S) yang aktif akan
# membatalkan pilihan profil. Biarkan sebagai komentar kalau ingin mengikuti profil.
SIGNALGATE_PROFILE=laptop

LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Endpoint loopback untuk perangkat ini. Tidak memerlukan token.
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
# Override eksplisit (hapus tanda # hanya kalau memang mau menimpa profil):
# OLLAMA_MODEL=qwen2.5:14b
# Reviewer dibaca berurutan, satu model di VRAM pada satu waktu. Maksimal 3.
# Isi ini ATAU OLLAMA_VALIDATOR_MODEL, tidak keduanya -- reviewer selalu menang.
# OLLAMA_REVIEWER_MODELS=["glm4:9b","gemma3:12b"]
OLLAMA_OFFLOAD_BETWEEN_MODELS=true
OLLAMA_NUM_CTX=16384

PIPELINE_MAX_EVENTS=3
RESEARCH_EXTRACTION_ATTEMPTS=2
RESEARCH_VALIDATOR_MODE=strict
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_MAX_PAGES=4
RESEARCH_CONTEXT_CHARS=3000
RESEARCH_SOURCE_URLS=[]

SIGNALGATE_DB_PATH=./signalgate.db

# --- Laporan empat panel (fundamental, valuation, technical, news) ---
# Prompt-nya kecil (metrik dan artikel terpilih), jadi konteksnya lebih kecil daripada jalur PDF.
WORKFLOW_NUM_CTX=8192
WORKFLOW_NUM_PREDICT=1024
# Kosong = pakai OLLAMA_MODEL sebagai analis dan SEMUA OLLAMA_REVIEWER_MODELS sebagai pembanding
# berurutan (profil workstation: glm4:9b lalu gemma3:12b, dilepas dari VRAM setelah gilirannya).
WORKFLOW_ANALYST_MODEL=
# Format lama, tepat satu pembanding (tetap didukung). Jangan isi bersama WORKFLOW_REVIEWER_MODELS.
WORKFLOW_REVIEWER_MODEL=
# WORKFLOW_REVIEWER_MODELS=["glm4:9b","gemma3:12b"]
# Biaya per run kira-kira 13 kredit: 4 seksi report + 5 kuartal + 2 jendela harga + aksi korporasi + berita.
WORKFLOW_QUARTERS=5
WORKFLOW_PRICE_CALENDAR_DAYS=180
WORKFLOW_NEWS_DAYS=90
WORKFLOW_NEWS_LIMIT=30
WORKFLOW_DEADLINE_SECONDS=1800

# --- Reviewer frontier DeepSeek (opsional, BERBAYAR) ---
# Mati secara bawaan: tanpa FRONTIER_ENABLED=true tidak ada panggilan, file, atau biaya frontier.
# Key hanya di file ini (backend). Jangan pernah menaruhnya di frontend/.env atau variabel VITE_*.
FRONTIER_ENABLED=false
FRONTIER_PROVIDER=deepseek
DEEPSEEK_API_KEY=
FRONTIER_BASE_URL=https://api.deepseek.com
# deepseek-flash = DeepSeek-V4.1-Flash (halaman harga resmi, 28 Sep 2026).
FRONTIER_MODEL=deepseek-flash
# shadow = hanya dicatat sebagai pembanding; escalation = dipakai lewat aturan rekonsiliasi kode.
FRONTIER_MODE=shadow
FRONTIER_REASONING_EFFORT=high
# Termasuk token penalaran (thinking mode). Jawaban terpotong dicatat gagal, bukan dipakai.
FRONTIER_MAX_TOKENS=8192
FRONTIER_TIMEOUT_SECONDS=180
# Semua percobaan, termasuk retry, dihitung ke batas panggilan dan biaya.
FRONTIER_MAX_CALLS_PER_RUN=3
FRONTIER_MAX_RETRIES=1
FRONTIER_MAX_TOKENS_PER_RUN=80000
# Batas biaya USD (estimasi), ditegakkan dengan reservasi konservatif sebelum tiap panggilan (byte UTF-8 prompt
# + cadangan, max_tokens penuh, harga peak). Bukan jaminan nominal absolut; overshoot dicatat dan menghentikan run.
# Bawaan disetel untuk saldo prabayar $2.
FRONTIER_MAX_COST_USD_PER_RUN=0.06
FRONTIER_MAX_COST_USD_PER_DAY=0.60
FRONTIER_MAX_COST_USD_TOTAL=1.80
FRONTIER_MAX_INPUT_CHARS=24000
# prefer_cache | offline (hanya respons tersimpan, tanpa jaringan) | refresh (selalu panggil API)
FRONTIER_CACHE_MODE=prefer_cache
# Run replay snapshot Sectors hanya membaca cache frontier kecuali ini true.
FRONTIER_CALLS_ON_REPLAY=false
