.DS_Store
# Only the setup entrypoints are shared; the rest of scripts/ stays local.
# Must be `scripts/*`, not `scripts/`: git cannot re-include a file whose parent dir is excluded.
scripts/*
!scripts/setup.py
!scripts/setup.cmd
cases/
data/library/
data/workflow/
data/scans/
# Cache respons + buku besar budget frontier (lokal; replay offline membaca dari sini).
data/frontier/
# Pilihan runtime dari dashboard + token gateway Colab (secrets.json, izin 0600). Jangan pernah di-commit.
data/runtime/

# Local archives, database sidecars and build/cache artifacts
.local-archive/
.dist/
*.db-*
*.sqlite
*.sqlite-*
.env.*
!.env.example
*.tsbuildinfo
.coverage
htmlcov/
